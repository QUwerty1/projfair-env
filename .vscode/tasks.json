{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: artisan serve",
      "detail": "php artisan serve --host=0.0.0.0 --port=8000. Отдаёт и API (/api/*), и собранную Vue-SPA, и Swagger UI (/api/documentation). --host обязателен: контейнер обращается к серверу снаружи.",
      "type": "shell",
      "command": "php artisan serve --host=0.0.0.0 --port=8000",
      "options": {
        "cwd": "${workspaceFolder}/projfair-back"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "artisan-serve",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/projfair-back"
        ],
        "pattern": [],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Laravel development server:",
          "endsPattern": "Development Server .* started"
        }
      }
    },
