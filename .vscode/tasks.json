      "label": "db: статус",
      "detail": "Проверка соединения с MySQL 8.0 (хост берётся из DB_HOST, иначе db)",
      "type": "shell",
      "command": "php -r 'try { new PDO(\"mysql:host=\" . (getenv(\"DB_HOST\") ?: \"db\"), \"root\", \"root\"); echo \"MySQL доступен\" . PHP_EOL; } catch (Throwable $e) { fwrite(STDERR, \"MySQL недоступен: \" . $e->getMessage() . PHP_EOL); exit(1); }'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
